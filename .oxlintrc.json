{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "**/*.d.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": "warn",
    "curly": "warn",
    "eqeqeq": "warn",
    "no-throw-literal": "warn"
  }
}
